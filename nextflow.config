// Main Consensus Pipeline Configuration for main_consensus_new.nf
//
// IMPORTANT: This pipeline is configured to run all processes in the noro-consensus environment.
// The conda environment contains all required dependencies:
// - Python 3.8+, Biopython, Pandas, NumPy
// - Nextflow, vsearch, MAFFT, IQ-TREE, TreeTime
// - Custom Python scripts for consensus generation and validation
//
// Environment Setup:
// 1. Create environment: conda env create -f environment.yml
// 2. Activate environment: conda activate noro-consensus
// 3. Run pipeline: nextflow run main_consensus_new.nf --input_file <file> --output_dir <dir>
//
// Note: The conda environment is automatically activated for all processes via the config.

// ==================== MANIFEST CONFIGURATION ====================
manifest {
    name = 'noro-consensus'
    author = 'LuJ'
    description = 'Norovirus representative consensus sequence pipeline with iterative validation and cross-cluster redundancy pruning'
    version = '1.1.0'
    nextflowVersion = '>=20.0.0'
}

// ==================== EXECUTOR CONFIGURATION ====================
executor {
    name = 'local'
    cpus = 10
    memory = '24 GB'
    queueSize = 20
}

// ==================== PROCESS CONFIGURATION ====================
process {
    // Default resource requirements
    cpus = 4
    memory = '8 GB'
    time = '24h'
    
    // Conda environment configuration - all processes run in noro-consensus environment
    conda = '/Users/LuJ/mambaforge/envs/noro-consensus'
    
    // Error handling
    errorStrategy = 'retry'
    maxRetries = 3
    maxErrors = 10
    
    // Specific process configurations for main_consensus_new.nf
    
    withName: 'MERGE_FASTA' {
        cpus = 1
        memory = '1 GB'
        time = '10m'
        errorStrategy = 'terminate'
    }
    
    withName: 'CLUSTER' {
        cpus = 10
        memory = '16 GB'
        time = '4h'
        errorStrategy = 'retry'
        maxRetries = 2
    }
    
    withName: 'SPLIT_CLUSTERS' {
        cpus = 1
        memory = '2 GB'
        time = '30m'
        errorStrategy = 'terminate'
    }
    
    withName: 'ALIGN' {
        cpus = 2
        memory = '4 GB'
        time = '48h'
        maxForks = 5
        errorStrategy = 'retry'
        maxRetries = 2
    }
    
    withName: 'CONSENSUS' {
        cpus = 2
        memory = '4 GB'
        time = '96h'
        maxForks = 5
        errorStrategy = 'retry'
        maxRetries = 2
    }
    
    withName: 'ENHANCED_CONSENSUS' {
        cpus = 2
        memory = '4 GB'
        time = '96h'
        maxForks = 5
        errorStrategy = 'retry'
        maxRetries = 1
    }
    
    withName: 'COLLECT_RESULTS' {
        cpus = 2
        memory = '4 GB'
        time = '30m'
        errorStrategy = 'terminate'
    }
    
    withName: 'FINAL_VALIDATION' {
        cpus = 2
        memory = '4 GB'
        time = '1h'
        errorStrategy = 'terminate'
    }
}

// ==================== REPORTING CONFIGURATION ====================
report {
    enabled = true
    file = "${params.output_dir ?: '.'}/pipeline_report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.output_dir ?: '.'}/timeline_report.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.output_dir ?: '.'}/trace.txt"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.output_dir ?: '.'}/pipeline_dag.html"
    overwrite = true
}

// ==================== LOGGING CONFIGURATION ====================
log {
    level = 'info'
    file = "${params.output_dir ?: '.'}/nextflow.log"
}

// ==================== DOCKER CONFIGURATION (OPTIONAL) ====================
// Uncomment if using Docker containers
/*
docker {
    enabled = true
    runOptions = '-u $(id -u):$(id -g)'
}

process {
    withName: 'ALIGN' {
        container = 'biocontainers/mafft:v7.490'
    }
    
    withName: 'CONSENSUS' {
        container = 'biocontainers/biopython:v1.79'
    }
    
    withName: 'ENHANCED_CONSENSUS' {
        container = 'biocontainers/biopython:v1.79'
    }
}
*/

// ==================== CLUSTER CONFIGURATION (OPTIONAL) ====================
// Uncomment for cluster execution (SLURM, SGE, etc.)
/*
executor {
    name = 'slurm'
    queueSize = 100
    pollInterval = '30 sec'
    dumpInterval = '5 min'
    queueStatInterval = '5 min'
    perJobMemLimit = true
    perCpuMemLimit = true
}

process {
    clusterOptions = '--account=your_account --partition=normal'
}
*/

// ==================== AWS BATCH CONFIGURATION (OPTIONAL) ====================
// Uncomment for AWS Batch execution
/*
executor {
    name = 'awsbatch'
    queueSize = 100
    pollInterval = '30 sec'
    dumpInterval = '5 min'
    queueStatInterval = '5 min'
    jobRole = 'arn:aws:iam::your_account:role/your_role'
}

aws {
    region = 'us-east-1'
    batch {
        jobDefinition = 'your-job-definition'
        jobQueue = 'your-job-queue'
    }
}
*/

// ==================== CUSTOM PARAMETERS ====================
params {
    // Input/Output parameters (will be overridden by command line)
    input_file = null
    output_dir = null
    
    // Clustering parameters
    ani_threshold = 0.9
    cluster_algorithm = "complete"
    
    // Validation parameters
    similarity_threshold = 95.0
    internal_similarity_threshold = 95.0
    alignment_end_min_coverage = 0.5
    max_iterations = 5
    
    // System parameters
    threads = 10
}
