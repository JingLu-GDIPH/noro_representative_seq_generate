def total_cpus = Math.max(1, (params.threads ?: 8) as int)

manifest {
    name = "noro-mapping-reference"
    author = "LuJ"
    description = "Phylogeny- and 150nt-window-guided norovirus mapping-reference branch"
    version = "0.1.0"
    nextflowVersion = ">=20.0.0"
}

executor {
    name = "local"
    cpus = total_cpus
    memory = "24 GB"
    queueSize = Math.max(4, total_cpus * 2)
}

process {
    conda = "/Users/LuJ/mambaforge/envs/noro-consensus"
    errorStrategy = "retry"
    maxRetries = 1
    maxErrors = 10
}

report {
    enabled = true
    file = "${params.output_dir ?: "."}/pipeline_report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.output_dir ?: "."}/timeline_report.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.output_dir ?: "."}/trace.txt"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.output_dir ?: "."}/pipeline_dag.html"
    overwrite = true
}
